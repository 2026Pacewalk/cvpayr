# ---------------------------------------------------------------------------
# CarVyapar.in — environment
# Copy to .env and fill in. Everything below the core block is optional; the
# app runs fully without it and says plainly in the UI what is not connected.
# ---------------------------------------------------------------------------

# ------------------------------- CORE --------------------------------------
# SQLite locally; swap for a Postgres URL in production.
DATABASE_URL="file:./dev.db"

# Signs the session cookie. Use a long random string; changing it signs everyone out.
AUTH_SECRET="change-me-to-a-long-random-string"

# Public origin, used in shareable catalog links and QR codes.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-side origin, used in reminder emails and by scripts/run-reminders.mjs.
APP_URL="http://localhost:3000"


# --------------------- SCHEDULED REMINDERS (recommended) -------------------
# Protects /api/cron/reminders. Required in production — without it the route
# is refused rather than left open. Any long random string works.
CRON_SECRET=""

# Point a scheduler at the route every ten minutes:
#   */10 * * * * curl -fsS -X POST https://your-domain/api/cron/reminders \
#                     -H "x-cron-secret: $CRON_SECRET"
# or run: node scripts/run-reminders.mjs
#
# Without a scheduler the app still sweeps opportunistically whenever someone
# uses the CRM (at most once every ten minutes). Set this to "1" to turn that
# fallback off once a real scheduler is in place.
DISABLE_REMINDER_FALLBACK=""


# ------------------------------- EMAIL -------------------------------------
# Both must be set before any email is attempted. Until then the notification
# settings screen shows email as "Not connected" and nothing is sent.
# The default implementation targets Resend; see src/lib/channels.ts.
EMAIL_API_KEY=""
EMAIL_FROM=""


# ------------------------------ WHATSAPP -----------------------------------
# The WhatsApp Business API needs an approved business account and approved
# message templates. All three must be set before any message is attempted.
# Until then the app uses wa.me deep links, which work today and open the
# dealer's own WhatsApp with the message pre-filled.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"

# Name of the approved template used for staff alerts.
WHATSAPP_ALERT_TEMPLATE=""
