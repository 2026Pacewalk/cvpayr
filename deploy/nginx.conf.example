# /etc/nginx/sites-available/carvyapar
#
# Plain HTTP only. Run `certbot --nginx -d carvyapar.in -d www.carvyapar.in`
# afterwards: it rewrites this block to add TLS and the HTTP redirect.

server {
    listen 80;
    listen [::]:80;
    server_name carvyapar.in www.carvyapar.in;

    # Vehicle photos are large; the default 1M rejects them.
    client_max_body_size 25M;

    # Next.js build assets are content-hashed, so they can be cached forever.
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_cache_valid 200 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    location /uploads/ {
        proxy_pass http://127.0.0.1:3000;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # Next.js reads this to build absolute URLs; without it every generated
        # link comes out as http:// even once TLS is on.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";

        proxy_read_timeout 120s;
    }

    # The reminder sweep can take a little while on a large dealership.
    location /api/cron/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
