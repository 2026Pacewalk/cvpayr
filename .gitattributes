# Normalise line endings so a Windows checkout cannot produce files that break
# on a Linux server.
* text=auto

# Shell scripts, cron files and systemd units must be LF. A CRLF shebang makes
# Linux report "bad interpreter", which is a confusing way to fail a deploy.
*.sh          text eol=lf
*.cron        text eol=lf
*.service     text eol=lf
*.conf        text eol=lf
*.example     text eol=lf
